<Ui xmlns="http://www.blizzard.com/wow/ui/"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.blizzard.com/wow/ui/
    ..\..\FrameXML\UI.xsd">
  <Script File="emoticons.lua"/>
  <!-- the communication layer, see docs/communication-layer.md -->
  <Script File="cobs.lua"/>
  <Script File="uper.lua"/>
  <Script File="messages.lua"/>
  <Script File="comm.lua"/>
  <Script File="colors.lua"/>
  <Script File="kackla.lua"/>
  <Script File="emoticonpicker.lua"/>
  <Script File="settings.lua"/>
  <Script File="copybox.lua"/>
  <Frame name="kacklaFrame" mixin="kacklaFrameMixin">
   <Scripts>
     <OnEvent method="OnEvent"/>
     <OnLoad method="OnLoad"/>
   </Scripts>
  </Frame>
  <!-- The picker button, placed like Blizzard's ChatFrameMenuButton just below it -->
  <Button name="KacklaEmoticonButton" frameStrata="MEDIUM" parent="ChatFrame1ButtonFrame" mixin="KacklaEmoticonButtonMixin">
   <Size x="32" y="32"/>
   <Anchors>
     <Anchor point="TOP" relativeTo="ChatFrameMenuButton" relativePoint="BOTTOM"/>
   </Anchors>
   <!-- empty square button, like the chat menu button's frame, with ☺ as text -->
   <NormalTexture file="Interface\Buttons\UI-SquareButton-Up"/>
   <PushedTexture file="Interface\Buttons\UI-SquareButton-Down"/>
   <HighlightTexture file="Interface\Buttons\UI-Common-MouseHilight" alphaMode="ADD"/>
   <ButtonText parentKey="Label"/>
   <!-- the chat font has ☺, the default button font shows it as a box -->
   <NormalFont style="ChatFontNormal"/>
   <PushedTextOffset x="1" y="-1"/>
   <Scripts>
     <OnLoad method="OnLoad"/>
     <OnEnter method="OnEnter"/>
     <OnLeave method="OnLeave"/>
     <OnClick method="OnClick"/>
   </Scripts>
  </Button>
  <!-- An entry of the picker, see KacklaPickerEntryMixin -->
  <Button name="KacklaPickerEntryTemplate" mixin="KacklaPickerEntryMixin" virtual="true">
   <Size x="26" y="26"/>
   <Layers>
     <!-- a gray border around the swatch, so dark colors stay visible -->
     <Layer level="BORDER">
       <Texture parentKey="SwatchBorder" hidden="true">
         <Anchors>
           <Anchor point="TOPLEFT" x="3" y="-3"/>
           <Anchor point="BOTTOMRIGHT" x="-3" y="3"/>
         </Anchors>
         <Color r="0.5" g="0.5" b="0.5"/>
       </Texture>
     </Layer>
     <Layer level="ARTWORK">
       <Texture parentKey="Swatch" hidden="true">
         <Anchors>
           <Anchor point="TOPLEFT" x="4" y="-4"/>
           <Anchor point="BOTTOMRIGHT" x="-4" y="4"/>
         </Anchors>
       </Texture>
     </Layer>
   </Layers>
   <HighlightTexture file="Interface\Buttons\UI-Common-MouseHilight" alphaMode="ADD"/>
   <ButtonText parentKey="Label"/>
   <!-- the chat font has the emoticon symbols, menu fonts show boxes -->
   <NormalFont style="ChatFontNormal"/>
   <Scripts>
     <OnClick method="OnClick"/>
     <OnEnter method="OnEnter"/>
     <OnLeave method="OnLeave"/>
   </Scripts>
  </Button>
  <!-- The picker window, opened by the picker button, see KacklaPickerMixin -->
  <Frame name="KacklaPickerFrame" parent="UIParent" inherits="BasicFrameTemplateWithInset, TabSystemOwnerTemplate" mixin="KacklaPickerMixin"
         toplevel="true" enableMouse="true" clampedToScreen="true" frameStrata="DIALOG" hidden="true">
   <Size x="200" y="200"/>
   <Anchors>
     <Anchor point="BOTTOMLEFT" relativeTo="KacklaEmoticonButton" relativePoint="TOPRIGHT" y="24"/>
   </Anchors>
   <Frames>
     <Frame parentKey="TabSystem" inherits="TabSystemTemplate">
       <KeyValues>
         <KeyValue key="minTabWidth" value="100" type="number"/>
       </KeyValues>
       <Anchors>
         <Anchor point="TOPLEFT" relativeKey="$parent" relativePoint="BOTTOMLEFT" x="12" y="2"/>
       </Anchors>
     </Frame>
     <Frame parentKey="Emoticons" hidden="true">
       <Size x="1" y="1"/>
       <Anchors>
         <Anchor point="TOPLEFT" x="12" y="-32"/>
       </Anchors>
     </Frame>
     <Frame parentKey="Colors" hidden="true">
       <Size x="1" y="1"/>
       <Anchors>
         <Anchor point="TOPLEFT" x="12" y="-32"/>
       </Anchors>
     </Frame>
   </Frames>
   <Scripts>
     <OnLoad method="OnLoad"/>
     <OnShow method="OnShow"/>
   </Scripts>
  </Frame>
  <!-- Edit box of the settings window, see KacklaSettingsEditBoxMixin -->
  <EditBox name="KacklaSettingsEditBoxTemplate" inherits="InputBoxTemplate" mixin="KacklaSettingsEditBoxMixin" autoFocus="false" virtual="true">
   <Size x="160" y="20"/>
   <Scripts>
     <OnEnterPressed method="OnEnterPressed"/>
     <OnEscapePressed method="OnEscapePressed"/>
     <OnEditFocusLost method="OnEditFocusLost"/>
   </Scripts>
  </EditBox>
  <!-- Settings window, opened with a bare /kackla or by right-clicking the
       emoticon button. Rows are settings, columns global and this character. -->
  <Frame name="KacklaSettingsFrame" parent="UIParent" inherits="BasicFrameTemplateWithInset" mixin="KacklaSettingsMixin"
         toplevel="true" movable="true" enableMouse="true" clampedToScreen="true" frameStrata="DIALOG" hidden="true">
   <Size x="490" y="450"/>
   <Anchors>
     <Anchor point="CENTER"/>
   </Anchors>
   <Layers>
     <Layer level="ARTWORK">
        <FontString inherits="GameFontHighlight" text="Global">
          <Anchors><Anchor point="TOPLEFT" x="100" y="-40"/></Anchors>
        </FontString>
        <FontString inherits="GameFontHighlight" text="This character">
          <Anchors><Anchor point="TOPLEFT" x="306" y="-40"/></Anchors>
        </FontString>
        <FontString inherits="GameFontNormal" text="Alias" justifyH="LEFT">
          <Anchors><Anchor point="TOPLEFT" x="16" y="-74"/></Anchors>
        </FontString>
        <FontString inherits="GameFontNormal" text="Format" justifyH="LEFT">
          <Anchors><Anchor point="TOPLEFT" x="16" y="-104"/></Anchors>
        </FontString>
        <FontString inherits="GameFontNormal" text="Channels" justifyH="LEFT">
          <Anchors><Anchor point="TOPLEFT" x="16" y="-134"/></Anchors>
        </FontString>
        <FontString inherits="GameFontHighlightSmall" justifyH="LEFT" text="Format: the first %s is the alias, the second %s the message">
          <Anchors><Anchor point="TOPLEFT" x="16" y="-160"/></Anchors>
        </FontString>
        <FontString inherits="GameFontHighlightSmall" justifyH="LEFT" text="Channels: comma-separated, e.g. GUILD,SAY,MyChannel, or ALL">
          <Anchors><Anchor point="TOPLEFT" x="16" y="-176"/></Anchors>
        </FontString>
        <FontString inherits="GameFontHighlightSmall" justifyH="LEFT" text="Tick a box to override the global setting for this character">
          <Anchors><Anchor point="TOPLEFT" x="16" y="-192"/></Anchors>
        </FontString>
        <FontString inherits="GameFontNormal" text="Preview">
          <Anchors><Anchor point="TOPLEFT" x="16" y="-216"/></Anchors>
        </FontString>
        <!-- the chat font, so emoticons show as in chat -->
        <FontString parentKey="Preview" inherits="ChatFontNormal" justifyH="LEFT" wordwrap="false">
          <Size x="360" y="0"/>
          <Anchors><Anchor point="TOPLEFT" x="100" y="-216"/></Anchors>
        </FontString>
        <FontString inherits="GameFontNormal" text="Used in">
          <Anchors><Anchor point="TOPLEFT" x="16" y="-238"/></Anchors>
        </FontString>
        <FontString parentKey="Channels" inherits="GameFontHighlight" justifyH="LEFT" wordwrap="false">
          <Size x="360" y="0"/>
          <Anchors><Anchor point="TOPLEFT" x="100" y="-238"/></Anchors>
        </FontString>
        <!-- the color picker, see KacklaSettingsMixin:OnColorSelect -->
        <FontString inherits="GameFontNormal" text="Color picker">
          <Anchors><Anchor point="TOPLEFT" x="16" y="-268"/></Anchors>
        </FontString>
        <FontString inherits="GameFontHighlightSmall" justifyH="LEFT" text="Pick a color and insert its token into your chat message">
          <Anchors><Anchor point="TOPLEFT" x="16" y="-286"/></Anchors>
        </FontString>
        <Texture parentKey="ColorSwatch">
          <Size x="64" y="32"/>
          <Anchors><Anchor point="TOPLEFT" x="220" y="-306"/></Anchors>
        </Texture>
        <FontString inherits="GameFontNormal" text="Hex">
          <Anchors><Anchor point="TOPLEFT" x="220" y="-354"/></Anchors>
        </FontString>
        <!-- the chat font, like the tokens in chat -->
        <FontString parentKey="ColorToken" inherits="ChatFontNormal" justifyH="LEFT">
          <Anchors><Anchor point="TOPLEFT" x="220" y="-382"/></Anchors>
        </FontString>
     </Layer>
   </Layers>
   <Frames>
      <EditBox parentKey="GlobalAlias" inherits="KacklaSettingsEditBoxTemplate">
        <KeyValues>
          <KeyValue key="scope" value="global" type="string"/>
          <KeyValue key="setting" value="alias" type="string"/>
        </KeyValues>
        <Anchors><Anchor point="TOPLEFT" x="100" y="-70"/></Anchors>
      </EditBox>
      <CheckButton parentKey="OverrideAlias" inherits="UICheckButtonTemplate" mixin="KacklaSettingsOverrideMixin">
        <Size x="26" y="26"/>
        <KeyValues>
          <KeyValue key="setting" value="alias" type="string"/>
        </KeyValues>
        <Anchors><Anchor point="TOPLEFT" x="272" y="-67"/></Anchors>
        <Scripts>
          <OnClick method="OnClick"/>
          <OnEnter method="OnEnter"/>
          <OnLeave method="OnLeave"/>
        </Scripts>
      </CheckButton>
      <EditBox parentKey="PlayerAlias" inherits="KacklaSettingsEditBoxTemplate">
        <KeyValues>
          <KeyValue key="scope" value="player" type="string"/>
          <KeyValue key="setting" value="alias" type="string"/>
        </KeyValues>
        <Anchors><Anchor point="TOPLEFT" x="306" y="-70"/></Anchors>
      </EditBox>
      <EditBox parentKey="GlobalFormat" inherits="KacklaSettingsEditBoxTemplate">
        <KeyValues>
          <KeyValue key="scope" value="global" type="string"/>
          <KeyValue key="setting" value="format" type="string"/>
        </KeyValues>
        <Anchors><Anchor point="TOPLEFT" x="100" y="-100"/></Anchors>
      </EditBox>
      <CheckButton parentKey="OverrideFormat" inherits="UICheckButtonTemplate" mixin="KacklaSettingsOverrideMixin">
        <Size x="26" y="26"/>
        <KeyValues>
          <KeyValue key="setting" value="format" type="string"/>
        </KeyValues>
        <Anchors><Anchor point="TOPLEFT" x="272" y="-97"/></Anchors>
        <Scripts>
          <OnClick method="OnClick"/>
          <OnEnter method="OnEnter"/>
          <OnLeave method="OnLeave"/>
        </Scripts>
      </CheckButton>
      <EditBox parentKey="PlayerFormat" inherits="KacklaSettingsEditBoxTemplate">
        <KeyValues>
          <KeyValue key="scope" value="player" type="string"/>
          <KeyValue key="setting" value="format" type="string"/>
        </KeyValues>
        <Anchors><Anchor point="TOPLEFT" x="306" y="-100"/></Anchors>
      </EditBox>
      <EditBox parentKey="GlobalChannels" inherits="KacklaSettingsEditBoxTemplate">
        <KeyValues>
          <KeyValue key="scope" value="global" type="string"/>
          <KeyValue key="setting" value="channels" type="string"/>
        </KeyValues>
        <Anchors><Anchor point="TOPLEFT" x="100" y="-130"/></Anchors>
      </EditBox>
      <CheckButton parentKey="OverrideChannels" inherits="UICheckButtonTemplate" mixin="KacklaSettingsOverrideMixin">
        <Size x="26" y="26"/>
        <KeyValues>
          <KeyValue key="setting" value="channels" type="string"/>
        </KeyValues>
        <Anchors><Anchor point="TOPLEFT" x="272" y="-127"/></Anchors>
        <Scripts>
          <OnClick method="OnClick"/>
          <OnEnter method="OnEnter"/>
          <OnLeave method="OnLeave"/>
        </Scripts>
      </CheckButton>
      <EditBox parentKey="PlayerChannels" inherits="KacklaSettingsEditBoxTemplate">
        <KeyValues>
          <KeyValue key="scope" value="player" type="string"/>
          <KeyValue key="setting" value="channels" type="string"/>
        </KeyValues>
        <Anchors><Anchor point="TOPLEFT" x="306" y="-130"/></Anchors>
      </EditBox>
      <!-- Blizzard's color wheel (hue and saturation) and value bar -->
      <ColorSelect parentKey="ColorPicker">
        <Size x="180" y="128"/>
        <Anchors><Anchor point="TOPLEFT" x="16" y="-306"/></Anchors>
        <ColorWheelTexture parentKey="Wheel">
          <Size x="128" y="128"/>
          <Anchors><Anchor point="TOPLEFT"/></Anchors>
        </ColorWheelTexture>
        <ColorWheelThumbTexture parentKey="WheelThumb" file="Interface\Buttons\UI-ColorPicker-Buttons">
          <Size x="10" y="10"/>
          <TexCoords left="0" right="0.15625" top="0" bottom="0.625"/>
        </ColorWheelThumbTexture>
        <ColorValueTexture parentKey="Value">
          <Size x="24" y="128"/>
          <Anchors><Anchor point="LEFT" relativeKey="$parent.Wheel" relativePoint="RIGHT" x="20"/></Anchors>
        </ColorValueTexture>
        <ColorValueThumbTexture parentKey="ValueThumb" file="Interface\Buttons\UI-ColorPicker-Buttons">
          <Size x="36" y="14"/>
          <TexCoords left="0.25" right="1.0" top="0" bottom="0.875"/>
        </ColorValueThumbTexture>
      </ColorSelect>
      <EditBox parentKey="ColorHex" inherits="InputBoxTemplate" mixin="KacklaColorHexMixin" autoFocus="false" letters="7">
        <Size x="80" y="20"/>
        <Anchors><Anchor point="TOPLEFT" x="256" y="-350"/></Anchors>
        <Scripts>
          <OnEnterPressed method="OnEnterPressed"/>
          <OnEscapePressed method="OnEscapePressed"/>
          <OnEditFocusLost method="OnEditFocusLost"/>
        </Scripts>
      </EditBox>
      <Button inherits="UIPanelButtonTemplate" text="Insert in chat">
        <Size x="120" y="22"/>
        <Anchors><Anchor point="TOPLEFT" x="220" y="-406"/></Anchors>
        <Scripts>
          <OnClick>self:GetParent():InsertColor()</OnClick>
        </Scripts>
      </Button>
   </Frames>
   <Scripts>
     <OnLoad method="OnLoad"/>
     <OnShow method="OnShow"/>
     <OnDragStart method="OnDragStart"/>
     <OnDragStop method="OnDragStop"/>
   </Scripts>
  </Frame>
  <!-- Text ready to copy, see copybox.lua -->
  <Frame name="KacklaCopyBoxFrame" parent="UIParent" inherits="BasicFrameTemplateWithInset" mixin="KacklaCopyBoxMixin"
         toplevel="true" movable="true" enableMouse="true" clampedToScreen="true" frameStrata="DIALOG" hidden="true">
   <Size x="520" y="360"/>
   <Anchors>
     <Anchor point="CENTER"/>
   </Anchors>
   <Layers>
     <Layer level="ARTWORK">
        <FontString inherits="GameFontHighlightSmall" text="Ctrl+C copies the selected text">
          <Anchors><Anchor point="BOTTOMLEFT" x="16" y="12"/></Anchors>
        </FontString>
     </Layer>
   </Layers>
   <Frames>
     <ScrollFrame parentKey="Scroll" inherits="InputScrollFrameTemplate">
       <KeyValues>
         <KeyValue key="maxLetters" value="0" type="number"/>
         <KeyValue key="hideCharCount" value="true" type="boolean"/>
       </KeyValues>
       <Anchors>
         <Anchor point="TOPLEFT" x="16" y="-34"/>
         <Anchor point="BOTTOMRIGHT" x="-32" y="32"/>
       </Anchors>
     </ScrollFrame>
     <Button inherits="UIPanelButtonTemplate" text="Select all">
       <Size x="100" y="22"/>
       <Anchors><Anchor point="BOTTOMRIGHT" x="-10" y="6"/></Anchors>
       <Scripts>
         <OnClick>self:GetParent():SelectText()</OnClick>
       </Scripts>
     </Button>
   </Frames>
   <Scripts>
     <OnLoad method="OnLoad"/>
     <OnDragStart method="OnDragStart"/>
     <OnDragStop method="OnDragStop"/>
   </Scripts>
  </Frame>
</Ui>
